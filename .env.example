# "openai" or "mock". If unset: openai when OPENAI_API_KEY is present, otherwise mock.
LLM_MODE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=
# Set to "none" for models that do not accept a temperature parameter.
OPENAI_TEMPERATURE=0
LLM_TIMEOUT_MS=30000

# Business rules
AUTO_APPROVE_LIMIT_EUR=200
MAX_TOOL_ITERATIONS=8
# Operator-pinned policy clock (ISO datetime). Leave empty in production (wall clock is used).
# The fixtures are dated around 2026-11-10; set AGENT_CLOCK=2026-11-10T10:00:00Z to replay
# the samples against the API. A request's own receivedAt is never used as the clock.
AGENT_CLOCK=

# Observability
LOG_LEVEL=info
LOG_PRETTY=0
# Directory where per-request trace JSON files are written ("" disables)
TRACE_DIR=traces
