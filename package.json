{
  "name": "disputo",
  "version": "0.1.0",
  "description": "AI agent that triages customer refund requests end-to-end with deterministic policy guardrails",
  "scripts": {
    "agent": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "samples": "tsx scripts/run-samples.ts",
    "eval:export": "tsx scripts/export-eval-runs.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run samples"
  },
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "dotenv": "^18.0.10",
    "openai": "^7.57.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "author": "Rinald Shehaj"
}
